# JW — variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# Ver .claude/skills/jw-parfum-setup/ para la guía paso a paso.

# --- Supabase (obligatorio) ---
# Panel del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend: correo de aviso de pedidos (obligatorio) ---
# https://resend.com/api-keys — en modo sandbox solo se puede enviar a la cuenta
# dueña del API key; para enviar a jamilwilliams054@gmail.com de forma confiable
# hay que verificar un dominio propio en Resend.
RESEND_API_KEY=
RESEND_FROM="JW <pedidos@jwparfum.com>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare R2: imágenes de producto (obligatorio para subir fotos) ---
R2_ACCOUNT_ID=
R2_BUCKET=jw-parfum
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Bootstrap del usuario administrador (solo para `pnpm bootstrap-admin`) ---
ADMIN_EMAIL=Jamil@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_DISPLAY_NAME="Jamil"
