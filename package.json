    "@supabase/supabase-js": "^2.97.0",
    "gsap": "^3.14.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.9.1",
    "resend": "^6.12.3"
  },
  "devDependencies": {
