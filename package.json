    "lint": "biome check",
    "format": "biome format --write",
    "og:image": "node scripts/generate-og-image.mjs",
    "bootstrap-admin": "bun scripts/bootstrap-admin.ts",
    "supabase": "supabase",
    "db:start": "supabase start",
