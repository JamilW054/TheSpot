    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/database/types/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked --schema public > src/database/types/database.types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
